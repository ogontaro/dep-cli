# dep の概念図。 `mise run diagram` で concepts.svg を再生成する。
direction: down

title: "dep の全体像" {
  near: top-center
  shape: text
  style.font-size: 28
  style.bold: true
}

files: "リポジトリの実ファイル\nhelmfile.yaml / variables.tf 等" {
  shape: page
}
config: ".dep/config.yaml\n\n【人間が書く・数行】\n各component の現在バージョンを\nどのファイルのどの正規表現で読むか" {
  shape: document
}
state: "State\n現在の各component バージョン" {
  shape: cylinder
}

upstream: "上流の公式ドキュメント\nTalos support matrix / Cilium compat 等" {
  shape: page
}
ai: "AI\nbuild-compat-matrix skill" {
  shape: person
}
matrix: ".dep/matrix.yaml\n\n【AI が作る】\ncomponent@version → 対応する kubernetes 範囲\n例: cilium 1.19 → 1.32..1.35" {
  shape: document
}

dep: "dep エンジン\n\nstatus  : 現在バージョン一覧\ncheck   : 現状が matrix と矛盾しないか\nmax     : どこまで上げてよいか(律速も表示)\nplan    : そこへ至る手順 / 到達不可の理由" {
  shape: hexagon
}
renovate: "renovate.json5\nallowedVersions を書き戻す" {
  shape: document
}

files -> config: 対象
config -> state: 抽出
upstream -> ai: 調べる
ai -> matrix: "dep matrix add"
state -> dep
matrix -> dep
dep -> renovate: "dep renovate sync"

topology: "matrix が表す関係 — 星型トポロジー(v1)\nすべての component が pivot(kubernetes)の対応範囲を1つ持つ" {
  direction: right
  k8s: kubernetes {
    style.fill: "#e8f0fe"
  }
  cilium -> k8s: "1.32..1.35"
  talos -> k8s: "1.31..1.36"
  keda -> k8s: "1.32..1.34"
  vpa -> k8s: "1.35..1.37"
}

matrix -> topology: {
  style.stroke-dash: 4
  style.stroke: "#9499AB"
}
